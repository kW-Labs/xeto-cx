//
// Example FPT script — economizer functional test excerpt, linked back to
// the OPR heat-recovery requirement to demonstrate traceability.
//

@ex-ahu-fpt: TestScript {
  dis: "AHU Functional Performance Test — Economizer and Heat Recovery"
  fptPhase
  targetSpec: "ph::Ahu"
  version: "1.0"
}

@ex-fpt-s01: TestStepDef {
  scriptRef: @ex-ahu-fpt
  stepId: "s01"
  instruction: "Command outdoor air temperature input below economizer high limit. Verify economizer modulates open."
  expected: "OA damper modulates toward 100 percent; mechanical cooling holds off."
  sortOrder: 1
}

@ex-fpt-s02: TestStepDef {
  scriptRef: @ex-ahu-fpt
  stepId: "s02"
  instruction: "With unit in minimum outdoor air, verify heat recovery wheel is rotating and recovering exhaust energy."
  expected: "Wheel rotates; exhaust-side and supply-side temperature differentials consistent with recovery."
  sortOrder: 2
}

@ex-fpt-s03: TestStepDef {
  scriptRef: @ex-ahu-fpt
  stepId: "s03"
  instruction: "Restore all overrides and return unit to normal automatic operation."
  expected: "Unit returns to scheduled operation with no active alarms."
  sortOrder: 3
}

//
// Example sequence application: a published guideline sequence, cited by
// section id (published prose is never embedded), implemented on the
// project AHU by an executable logic the engineer designed. The statement
// anchors the requirement to the cited clause. The logic is referenced by
// identity and hash, never restated here. Its parameter records carry the
// evidence for each fill-in value, and a replay of the logic against the
// unit's trends proves the requirement on the performance plane.
//
// The gate, shown: a June replay ran before TAB measured the maximum duct
// static pressure. The logic consumes that value, so the June result is
// inconclusive: an owed value blocks the proof instead of being defaulted.
// The July retest, after the TAB report, passed. The parameter records show
// today's resolved state; the June result's notes say what was owed.
//

@ex-seq-g36: SequenceSource {
  dis: "ASHRAE Guideline 36-2024"
  publisher: "ASHRAE"
  docId: "G36-2024"
  edition: "2024"
}

@ex-seq-sat: SequenceSection {
  sourceRef: @ex-seq-g36
  sectionId: "5.16.2.2"
  title: "Supply air temperature setpoint reset"
  modeLogicSection
  stableAnchor
}

@ex-seq-sat-stmt: SequenceStatement {
  sectionRef: @ex-seq-sat
  requirementRef: @ex-req-sat-reset
  sortOrder: 1
}

// Supply fan control, which carries the duct static pressure setpoint reset.
// Section id as the Modelica Buildings Library 12.1.0 documentation of the
// multiple-zone VAV controller cites it, at the third level.
@ex-seq-dsp: SequenceSection {
  sourceRef: @ex-seq-g36
  sectionId: "5.16.1"
  title: "Supply fan control and duct static pressure setpoint reset"
  modeLogicSection
}

// Proven by replay of the logic on the performance plane. The FPT step
// below keeps citing it as supplementary field evidence: it exercises
// branches under forced conditions that trends may never reach. A failed
// step raises a CxIssue; it does not write this requirement's result.
@ex-req-sat-reset: Requirement {
  dis: "AHU supply air temperature reset"
  docRef: @ex-opr
  reqId: "OPR-3.3.1"
  category: "energy"
  oprEnergy
  narrative: "Air handling unit supply air temperature setpoint shall reset per the trim-and-respond logic of the cited guideline section, within the design minimum and maximum setpoint limits."
  citation: "ASHRAE G36-2024 section 5.16.2.2"
  performancePlane
  reqRequired
  targetSpec: "ph::Ahu"
}

@ex-ahu-1: Dict {
  dis: "AHU-1"
}

@ex-controls-drawings: Dict {
  dis: "Mechanical controls drawings"
}

@ex-tab-report: Dict {
  dis: "TAB report"
}

// The engineer's executable design for AHU-1: one control description
// language class extending the block library's multiple-zone VAV
// controller, covering both cited sections. One record per revision.
// The parameter, input and output names below (TSupCoo_max, pMaxSet,
// u1SupFan, TAirSupSet) are that controller's in Modelica Buildings
// Library 12.1.0. logicHash and logicUri are illustrative.
@ex-seq-logic: SequenceLogic {
  dis: "AHU-1 multiple-zone VAV controller, design rev 3"
  cxProjectRef: @ex-project
  siteRef: @ex-site
  equipRefs: { @ex-ahu-1 }
  sourceRef: @ex-seq-g36
  sectionRefs: { @ex-seq-sat, @ex-seq-dsp }
  cdlLogic
  logicStandard: "ANSI/ASHRAE 231-2026"
  logicClass: "Example.Ahu1Controller"
  logicHash: "sha256:595cd330717f89364edeccaa8940064643291570e9af746304c71bdfd77cf8d7"
  logicUri: Uri "https://example.org/designs/ahu1-controller/"
  revision: "3"
  libraryName: "Modelica Buildings Library"
  libraryVersion: "12.1.0"
  designerRole
  authoredBy: "Example design engineer"
}

// The engineer of record reviewed the logic; without this the logic is
// unreviewed
@ex-seq-logic-sig: Attestation {
  subjectRef: @ex-seq-logic
  eorRole
  userName: "Example Engineer of Record"
  signedAt: DateTime "2026-04-02T10:00:00-06:00 Denver"
}

// Designer-scheduled setpoint limit: a guideline fill-in, resolved from the
// controls drawings
@ex-seq-lp-maxsat: SequenceLogicParam {
  logicRef: @ex-seq-logic
  logicParam: "TSupCoo_max"
  dis: "Maximum cooling supply air temperature setpoint"
  sourceSymbol: "Max_ClgSAT"
  definedIn: "3.1.4.1"
  designerRole
  placeholder
  val: Number "65°F"
  unit: "°F"
  designValue
  sourceDocRef: @ex-controls-drawings
  sourcePage: 14
  sourceLocator: "Clause 3.2, setpoint table row 4"
  resolvedAt: DateTime "2026-03-15T09:00:00-06:00 Denver"
}

// TAB-measured pressure ceiling: a guideline fill-in, field-determined per
// the guideline's procedure and resolved from the TAB report on July 10.
// Until then it was a placeholder with no value, which gated the June replay.
@ex-seq-lp-maxdsp: SequenceLogicParam {
  logicRef: @ex-seq-logic
  logicParam: "pMaxSet"
  dis: "Maximum duct static pressure setpoint"
  sourceSymbol: "Max_DSP"
  definedIn: "3.2.1.1"
  tabRole
  placeholder
  procedure: "Field-measured at design airflow per the guideline's TAB procedure"
  val: Number "1.2inH₂O"
  unit: "inH₂O"
  fieldMeasuredValue
  sourceDocRef: @ex-tab-report
  sourceLocator: "AHU-1 duct static pressure test"
  resolvedAt: DateTime "2026-07-10T14:00:00-06:00 Denver"
}

// Defaults record: no logicOutput, never graded. Two minutes of time
// tolerance, compared only while the supply fan is proven on.
@ex-req-sat-reset-rd: ReplayCriterion {
  requirementRef: @ex-req-sat-reset
  logicRef: @ex-seq-logic
  timeTolAbs: 120
  indicatorInput: "u1SupFan"
  autoMode
}

// Graded output: the supply air temperature setpoint, within half a degree
@ex-req-sat-reset-r: ReplayCriterion {
  requirementRef: @ex-req-sat-reset
  logicRef: @ex-seq-logic
  logicOutput: "TAirSupSet"
  unit: "°F"
  valueTolAbs: 0.5
}

@ex-seq-replay-jun: SequenceReplayTest {
  dis: "AHU-1 controller replay, June"
  cxProjectRef: @ex-project
  siteRef: @ex-site
  equipRef: @ex-ahu-1
  requirementRefs: { @ex-req-sat-reset }
  logicRef: @ex-seq-logic
  designParamSource
  fptPhase
  activityDeferred
  attemptNo: 1
}

@ex-vr-replay-jun: VerificationResult {
  requirementRef: @ex-req-sat-reset
  criterionRef: @ex-req-sat-reset-r
  activityRef: @ex-seq-replay-jun
  subjectRef: @ex-ahu-1
  outcomeInconclusive
  performancePlane
  autoMode
  ranAt: DateTime "2026-06-15T08:00:00-06:00 Denver"
  evalStart: DateTime "2026-06-01T00:00:00-06:00 Denver"
  evalEnd: DateTime "2026-06-15T00:00:00-06:00 Denver"
  notes: "Parameter gate: Max_DSP (pMaxSet) was an unresolved TAB placeholder"
}

// paramSetHash is the canonical digest of the two evidenced values fed to
// the reference, "TSupCoo_max=65°F" and "pMaxSet=1.2inH₂O", sorted
// bytewise and LF-joined
@ex-seq-replay-jul: SequenceReplayTest {
  dis: "AHU-1 controller replay, July"
  cxProjectRef: @ex-project
  siteRef: @ex-site
  equipRef: @ex-ahu-1
  requirementRefs: { @ex-req-sat-reset }
  logicRef: @ex-seq-logic
  referenceEngine: "Reference simulation of the logic against the named block library version"
  designParamSource
  paramSetHash: "sha256:e9ac3b88f808231247e49024c792a9213792a82bbe7645df9d1cf95cfe836541"
  fptPhase
  activityPassed
  attemptNo: 2
  retestOf: @ex-seq-replay-jun
}

// Trending is a commissioning prerequisite of a replay: the control
// description language excludes it from the logic's scope
@ex-seq-replay-trends: ActivityPrerequisite {
  activityRef: @ex-seq-replay-jul
  prereqSystemOperational
  description: "Interval trends at 60 s or faster for outdoor air temperature, fan status, operation mode, zone cooling requests and the SAT setpoint"
}

@ex-vr-replay-jul: VerificationResult {
  requirementRef: @ex-req-sat-reset
  criterionRef: @ex-req-sat-reset-r
  activityRef: @ex-seq-replay-jul
  subjectRef: @ex-ahu-1
  outcomePass
  performancePlane
  autoMode
  ranAt: DateTime "2026-07-29T08:00:00-06:00 Denver"
  evalStart: DateTime "2026-07-15T00:00:00-06:00 Denver"
  evalEnd: DateTime "2026-07-29T00:00:00-06:00 Denver"
  evalSpan: "2026-07-15..2026-07-28, supply fan proven on"
  adherencePct: 100
  coveragePct: 98.6
  notes: "Respond branch exercised on 6 of 14 days; trim held at the maximum otherwise"
}

// FPT step citing the requirement as supplementary field evidence, closing
// the loop from cited clause to witnessed test
@ex-fpt-s04: TestStepDef {
  scriptRef: @ex-ahu-fpt
  stepId: "s04"
  instruction: "Generate cooling requests from multiple zones; observe supply air temperature setpoint response."
  expected: "Setpoint trims and responds within the configured minimum and maximum limits."
  requirementRefs: { @ex-req-sat-reset }
  sortOrder: 4
}

//
// EBCx continuation — the same building, after turnover. Demonstrates the
// 202 Foreword transitions (OPR -> CFR, Cx Plan -> OCx Plan), continuous
// verification results on all three outcomes, an owner-accepted variance
// (202 Appendix O), and the Systems Manual as an index of living records.
// The project record above is shown at its design-phase snapshot.
//

// ── OPR transitions to CFR; a failing requirement is amended ─────────────

@ex-cfr: Cfr {
  dis: "Example Facility CFR v1.0"
  siteRef: @ex-site
  version: "1.0"
  docSuperseded
  narrative: "Current facility requirements carried forward from the project OPR at turnover."
  sourceOprRefs: { @ex-opr }
}

@ex-cfr-2: Cfr {
  dis: "Example Facility CFR v1.1"
  siteRef: @ex-site
  version: "1.1"
  docPublished
  publishedAt: DateTime "2026-07-08T12:00:00-06:00 Denver"
  supersedesRef: @ex-cfr
  narrative: "Amended after owner accepted a seasonal space-temperature variance (see variance record)."
  sourceOprRefs: { @ex-opr }
}

// CFR v1.1 restates the space-temperature requirement at the amended
// adherence target; supersedesRef preserves lineage across the OPR->CFR
// transition.
@ex-req-space-temp-cfr: Requirement {
  dis: "Space temperature compliance (amended)"
  docRef: @ex-cfr-2
  reqId: "CFR-4.1.1"
  category: "comfort"
  narrative: "Occupied spaces shall maintain 70-74 degF during occupied hours at 90 percent adherence through 2026-09-30, returning to 95 percent thereafter."
  performancePlane
  reqRequired
  spaceSpec: "ph::Space"
  supersedesRef: @ex-req-space-temp
}

@ex-req-space-temp-cfr-c: PerformanceCriterion {
  requirementRef: @ex-req-space-temp-cfr
  pointSpec: "ph::Point"
  minVal: 70
  maxVal: 74
  unit: "°F"
  adherenceTarget: 90
  evalSpan: "occupied hours, 30day rolling"
  autoMode
}

// ── Ongoing commissioning program (202 section 3, "Ongoing Cx") ──────────

@ex-ocx-plan: CxPlan {
  dis: "Example Facility OCx Plan"
  siteRef: @ex-site
  cxProjectRef: @ex-project
  version: "1.0"
  docPublished
}

@ex-ocx: OcxProgram {
  dis: "Example Facility Ongoing Cx"
  siteRef: @ex-site
  cfrRef: @ex-cfr-2
  planRef: @ex-ocx-plan
  startedAt: Date "2026-07-01"
  reviewCadence: Cadence "quarterly"
}

// Facility change event — the OCx loop of Guideline 0 Figure B-1: a use
// change is evaluated against the CFR, dispositioned, and follow-on
// updates tracked to closure
@ex-change-tenant: FacilityChange {
  dis: "Second-floor tenant fit-out: open office to conference center"
  siteRef: @ex-site
  ocxProgramRef: @ex-ocx
  changeOfUse
  description: "Occupancy density triples in the affected zones; ventilation and cooling requirements re-evaluated against the CFR."
  occurredAt: Date "2026-07-10"
  evaluatedAt: Date "2026-07-15"
  changesOpr
  requirementRefs: { @ex-req-space-temp-cfr }
  systemsManualUpdated
}

// ── Verification results — one per outcome ───────────────────────────────

// Conformance check: heat-recovery marker present on every scoped AHU
@ex-vr-pass: VerificationResult {
  requirementRef: @ex-req-ahu-hr
  criterionRef: @ex-req-ahu-hr-c
  outcomePass
  conformancePlane
  autoMode
  ranAt: DateTime "2026-06-01T08:00:00-06:00 Denver"
  notes: "heatRecovery marker present on all AHU records in scope"
}

// Performance check: June adherence landed at 91% against the 95% target
@ex-vr-fail: VerificationResult {
  requirementRef: @ex-req-space-temp
  outcomeFail
  performancePlane
  autoMode
  ranAt: DateTime "2026-06-30T17:00:00-06:00 Denver"
  evalSpan: "2026-06-01..2026-06-30 occupied hours"
  adherencePct: 91
}

// Inconclusive: trend data gap — honestly not "pass" and not "fail"
@ex-vr-inconclusive: VerificationResult {
  requirementRef: @ex-req-space-temp
  outcomeInconclusive
  performancePlane
  autoMode
  ranAt: DateTime "2026-05-31T17:00:00-06:00 Denver"
  evalSpan: "2026-05-01..2026-05-31 occupied hours"
  notes: "Zone sensors offline 5/09-5/21; insufficient data to evaluate adherence"
}

// ── Failing result -> issue -> owner-accepted variance (202 App O) ───────

@ex-issue-adherence: CxIssue {
  dis: "June space-temp adherence 91% vs 95% required"
  cxProjectRef: @ex-project
  siteRef: @ex-site
  description: "West-zone afternoon solar load drives excursions above 74 degF; mitigation requires shade retrofit scheduled for Q4."
  analyticsFault
  priorityMedium
  issueClosed
  ballInCourt: CxParty "owner"
  requirementRef: @ex-req-space-temp
  sourceAnalytics
  sourceRef: @ex-vr-fail
}

@ex-variance-adherence: RequirementVariance {
  requirementRef: @ex-req-space-temp
  description: "Owner accepts 90 percent adherence for the 2026 cooling season pending Q4 shade retrofit."
  impacts: "Comfort: afternoon excursions to 76 degF in west zones. Energy: none. Health/safety: none."
  expiresAt: Date "2026-09-30"
  sourceIssueRef: @ex-issue-adherence
  attestationRef: @ex-variance-signoff
  acceptedAt: DateTime "2026-07-08T10:00:00-06:00 Denver"
}

@ex-variance-signoff: Attestation {
  subjectRef: @ex-variance-adherence
  ownerRole
  userName: "Example Owner Rep"
  signedAt: DateTime "2026-07-08T10:00:00-06:00 Denver"
  notes: "Variance accepted per 202 Appendix O(a); CFR updated to v1.1"
}

// ── Finding -> measure -> savings (EBCx master list of findings) ─────────
// The issue above is the finding; the measure carries the solution and its
// economics; savings records harden from estimated toward verified.

@ex-measure-shade: CxMeasure {
  dis: "West-zone exterior shade retrofit"
  cxProjectRef: @ex-project
  siteRef: @ex-site
  findingRef: @ex-issue-adherence
  description: "Install exterior shading on west-facing glazing to eliminate afternoon solar-driven temperature excursions."
  capitalMeasure
  sowMedium
  measureApproved
  costEst: 42000
  paybackYears: 8.5
  ownerPriority: 1
  benefits: "Restores 95 percent comfort adherence; reduces peak cooling load."
  risks: "Facade permit review may extend schedule past Q4."
}

@ex-measure-shade-sav: SavingsEstimate {
  measureRef: @ex-measure-shade
  elecSavings
  estimatedBasis
  annualQty: 31000
  qtyUnit: "kWh"
  annualCost: 4900
  method: "hourly simulation of west-zone cooling load with and without shading"
  estimatedAt: Date "2026-07-05"
}

